class Bank {
    // Final variable
    final String IFSC = "HDFC0001234";

    // Final method
    final void showIFSC() {
        System.out.println("IFSC Code: " + IFSC);
    }
}

class HDFCBank extends Bank {

    /*
    // This will cause a compile-time error
